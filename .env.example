# -----------------------------------------------------------------------------
# Zero-Device Biometric Payment System — example environment configuration.
# Copy this file to `.env` and adjust. NEVER commit the real `.env`.
# -----------------------------------------------------------------------------

# Flask session signing key. Generate a strong one for anything beyond a demo:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me-please-0123456789abcdef

# Fernet key used to encrypt biometric templates at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, the app derives a deterministic *demo* key from SECRET_KEY
# (fine for local demos, NOT for production).
BIOMETRIC_ENCRYPTION_KEY=

# Database location (SQLAlchemy URL). Defaults to a local SQLite file.
DATABASE_URL=sqlite:///instance/payments.db

# Flask environment
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1

# ---- Matching defaults (tunable at runtime via the admin UI too) ----
# Similarity (0..1) a probe must reach to match an enrolled template.
MATCH_THRESHOLD=0.55
# Minimum capture quality for the liveness/content check to pass.
LIVENESS_MIN_QUALITY=0.15
# Weights used when authenticating with BOTH modalities (should sum to 1.0).
FUSION_WEIGHT_FACE=0.5
FUSION_WEIGHT_FINGERPRINT=0.5
